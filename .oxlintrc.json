{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [".claude/", ".agent/"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "promise"
  ],
  "jsPlugins": ["@shadcn/lint"],
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "options": {
    "typeAware": true,
    "typeCheck": false,
    "maxWarnings": 10
  },
  "rules": {
    "no-alert": "error",
    "no-underscore-dangle": ["error", { "allow": ["__filename", "__dirname"] }],
    "no-console": "error",
    "no-plusplus": "off",
    "oxc/approx-constant": "warn",
    "eslint/prefer-const": ["error", { "destructuring": "any" }],
    "typescript/no-explicit-any": "error",
    "react/react-in-jsx-scope": "off",
    "shadcn/no-arbitrary-values": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.{ts,tsx}", "tests/unit/**"],
      "plugins": ["vitest"],
      "env": { "vitest": true }
    },
    {
      "files": ["src/components/ui/**/*.{ts,tsx}"],
      "excludeFiles": ["**/creatable-combobox.tsx"],
      "rules": {
        "shadcn/no-arbitrary-values": "error"
      }
    }
  ]
}
