{
  "languages": {
    "JavaScript": {
      "language_servers": ["oxlint", "!eslint", "..."]
    },
    "TypeScript": {
      "language_servers": ["oxlint", "!eslint", "..."]
    },
    "TSX": {
      "language_servers": ["oxlint", "!eslint", "..."]
    },
    "CSS": {
      "language_servers": ["tailwindcss-language-server", "!vscode-css-language-server", "..."]
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
